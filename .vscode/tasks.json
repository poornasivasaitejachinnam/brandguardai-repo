		},
		{
			"label": "BrandGuard Frontend Build",
			"type": "shell",
			"command": "npm run build",
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BrandGuard Backend Smoke Test",
			"type": "shell",
			"command": "npm run test:smoke",
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "BrandGuard Frontend Dev Server",
			"type": "shell",
			"command": "npm run dev",
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BrandGuard Backend Server",
			"type": "shell",
			"command": "npm start",
			"options": {
