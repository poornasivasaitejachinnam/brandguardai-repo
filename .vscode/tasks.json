{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Inspect latest backend listener",
			"type": "shell",
			"command": "Get-NetTCPConnection -LocalPort 5000 -State Listen | Select-Object -ExpandProperty OwningProcess; Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -eq (Get-NetTCPConnection -LocalPort 5000 -State Listen).OwningProcess } | Select-Object -ExpandProperty ParentProcessId",
			"args": [],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BrandGuard Backend",
			"type": "shell",
			"command": "npm run dev",
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BrandGuard Frontend",
			"type": "shell",
			"command": "npm run dev",
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BrandGuard AI Service",
			"type": "shell",
			"command": "uvicorn app.main:app --reload --port 8000",
			"options": {
				"cwd": "${workspaceFolder}/ai-service"
			},
			"windows": {
				"command": ".\\.venv\\Scripts\\activate.bat && uvicorn app.main:app --reload --port 8000"
			},
			"osx": {
				"command": "source .venv/bin/activate && uvicorn app.main:app --reload --port 8000"
			},
			"linux": {
				"command": "source .venv/bin/activate && uvicorn app.main:app --reload --port 8000"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "BrandGuard Smoke Test",
			"type": "shell",
			"command": "npm run test:smoke",
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "BrandGuard Workflow Test",
			"type": "shell",
