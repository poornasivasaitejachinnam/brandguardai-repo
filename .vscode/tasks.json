		{
			"label": "BrandGuard UI and backend validation",
			"type": "shell",
			"command": "npm run build && npm --prefix ../backend run test:smoke",
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "BrandGuard final UI polish validation",
			"type": "shell",
			"command": "npm run build && npm --prefix ../backend run test:smoke",
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
